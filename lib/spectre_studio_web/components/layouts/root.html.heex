<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Studio observes production systems from an operator's browser. It is
    never a public document, so it opts out of indexing and archiving. --%>
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#050506" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />

    <title>{Layouts.document_title(assigns[:page_title])}</title>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-[color:var(--page-bg)] font-mono text-[color:var(--fg)] antialiased">
    {@inner_content}
  </body>
</html>

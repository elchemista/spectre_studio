<.error_shell code="500" status="Internal server error">
  <p class="term-out text-[0.8rem] t-dim">
    Studio failed while handling this request
  </p>
  <p class="term-comment text-[0.72rem] t-faint">
    the details are in the server log — Studio does not put them on this page,
    because an error page is not a place to leak internals
  </p>
</.error_shell>
